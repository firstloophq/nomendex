{
    "name": "nomendex-collab",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "bunx wrangler dev",
        "deploy": "bunx wrangler deploy",
        "db:migrate": "bunx wrangler d1 execute nomendex-collab-db --file=./schema.sql",
        "db:migrate:local": "bunx wrangler d1 execute nomendex-collab-db --local --file=./schema.sql",
        "db:create": "bunx wrangler d1 create nomendex-collab-db"
    },
    "dependencies": {
        "@clerk/backend": "^1.0.0",
        "@octokit/rest": "^21.0.0",
        "lib0": "^0.2.0",
        "partyserver": "^0.1.5",
        "y-partyserver": "^1.0.0",
        "y-protocols": "^1.0.0",
        "yjs": "^13.6.0"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^4.0.0",
        "wrangler": "^4.0.0",
        "typescript": "^5.0.0"
    }
}
