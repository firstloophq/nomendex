# Team backend base URL for REST APIs used by team-mode flows
TEAM_BACKEND_HTTP_URL=http://localhost:4444

# Optional explicit CRDT websocket URL for sidecar relay.
# If omitted, sidecar derives ws URL from TEAM_BACKEND_HTTP_URL.
# TEAM_BACKEND_WS_URL=ws://localhost:4444/ws/crdt

# Relay is enabled by default when TEAM_BACKEND_HTTP_URL/WS is configured.
# Set to false/off/0 to force-disable relay for debugging.
# CRDT_RELAY_ENABLED=false
